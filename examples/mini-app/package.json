{
  "name": "nextjs-toolkit-mini-app",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable NestJS app that exercises @alaska115/nextjs-toolkit end-to-end. Boots, accepts requests, demonstrates 6 of the package's modules.",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "ts-node scripts/smoke.ts"
  },
  "dependencies": {
    "@alaska115/nextjs-toolkit": "^0.4.1",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^4.18.2",
    "joi": "^18.0.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^18.19.130",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
