# Copy to .env and tweak. The toolkit's Joi schema validates these at boot.
NODE_ENV=development
APP_NAME=mini-app
APP_ENV=development
HTTP_PORT=3001
HTTP_GLOBAL_PREFIX=api
LOG_LEVEL=info
CORS_ENABLED=true
CORS_ORIGINS=*
OBSERVABILITY_LOGGING=console
OBSERVABILITY_TRACING=noop
OBSERVABILITY_METRICS=noop
